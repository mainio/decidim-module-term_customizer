<%
constraint = form.object
subject_form = constraint.subject_form
selected_manifest = constraint.subject_manifest.to_s
selected_space = subject_form&.subject_id
selected_component = subject_form&.component_form&.component_id
%>

<div class="card multifield-field constraint-section" id="<%= id %>-field">
  <div class="card-divider multifield-field-divider section-divider">
    <h2 class="card-title">
      <span>
        <%== "#{t(".constraint")}" %>
      </span>

      <button class="button button__sm button__transparent-secondary small alert hollow remove-field button--title mb-2">
        <%= icon("delete-bin-line") %>
        <%= t(".remove") %>
      </button>
    </h2>
  </div>

  <div class="card-section">
    <div class="row column">
      <%= form.select :subject_manifest, subject_manifests.map { |m| [
        I18n.t("activerecord.models.#{m.model_class_name.underscore}.other"),
        m.name
      ] }, { include_blank: true }, class: "constraint-subject-selector" %>
    </div>

    <% subject_manifests.each do |manifest| %>
      <% manifest_selected = manifest.name.to_s == selected_manifest %>

      <div class="manifest-container" data-manifest="<%= manifest.name %>">
        <%= fields_for "constraints[#{index}][subject_model][#{manifest.name}]", constraint do |subject_fields| %>
          <div class="row column">
            <%= subject_fields.hidden_field :subject_manifest, value: manifest.name.to_s %>
            <%= subject_fields.select :subject_id, constraint_space_options(manifest), { selected: (selected_space if manifest_selected), include_blank: true }, class: "constraint-subject-model-selector" %>
          </div>
        <% end %>

        <%# The components of the selected space only. Every other space gets %>
        <%# its fields from the constraint_components endpoint when it is %>
        <%# selected, so that the form does not grow with the space count. %>
        <div class="component-container-holder">
          <% if manifest_selected && selected_space.present? %>
            <% space = constraint_space(manifest.name, selected_space) %>

            <%= fields_for "constraints[#{index}][subject_model][#{manifest.name}][component_model][#{selected_space}]", constraint do |component_fields| %>
              <div class="row column component-container" data-components="<%= selected_space %>">
                <%= component_fields.hidden_field :subject_id, value: selected_space %>
                <% if space.respond_to?(:components) %>
                  <%= component_fields.select :component_id, constraint_component_options(space), { selected: selected_component, include_blank: true }, class: "constraint-component-selector" %>
                <% else %>
                  <%= component_fields.hidden_field :component_id, value: nil %>
                <% end %>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>

    <%= form.hidden_field :id %>
    <%= form.hidden_field :deleted %>
  </div>
</div>
